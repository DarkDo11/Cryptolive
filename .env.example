# Optional: free CoinGecko Demo API key raises the upstream rate limit (~30 req/min, 10k/month).
# Get one at https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
PORT=8080
LOG_LEVEL=info
# Public URL used in sitemap.xml
PUBLIC_URL=http://localhost:8080
# Per-IP limit for /api requests per minute
API_RATE_LIMIT=120
# On-disk cache snapshot (set empty to disable)
CACHE_FILE=.cache/cache.json
# Send Strict-Transport-Security (only when behind HTTPS)
# ENABLE_HSTS=1
# Pre-fetch detail payloads for the top N coins (0 disables)
WARM_COINS=10
# Access log format: text | json
LOG_FORMAT=text
# Honour X-Forwarded-For (only behind a trusted reverse proxy)
# TRUST_PROXY=1
# Cap concurrent SSE connections
# MAX_SSE_CLIENTS=500
