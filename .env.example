# Optional: free CoinGecko Demo API key raises the upstream rate limit (~30 req/min, 10k/month).
# Get one at https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
PORT=8080
LOG_LEVEL=info
# Public URL used in sitemap.xml
PUBLIC_URL=http://localhost:8080
# Per-IP limit for /api requests per minute
API_RATE_LIMIT=120
# On-disk cache snapshot (set empty to disable)
CACHE_FILE=.cache/cache.json
